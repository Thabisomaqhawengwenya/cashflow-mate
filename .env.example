# CashFlow Mate — Environment Configuration Template

# Server Port
PORT=4000

# JSON Web Token Secret (Change in production)
JWT_SECRET=cashflow_mate_secure_jwt_secret_change_me_in_prod_2026

# Local SQLite Database Path
DATABASE_PATH=cashflow_mate.db

# CORS Allowed Origin
CORS_ORIGIN=*

# Google Gemini API Key (Optional: when unset, app automatically runs high-accuracy Zimbabwean merchant rule fallback)
GEMINI_API_KEY=

# Supabase PostgreSQL Configuration (Optional: for cloud deployment migrations)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
