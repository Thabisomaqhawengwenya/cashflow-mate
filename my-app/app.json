{
  "expo": {
    "name": "Cashflow",
    "slug": "cashflow",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cashflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.maqhawe.cashflow",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#06152E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#06152E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "maqhawengwenya",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d9c881ab-b0cc-4feb-8e23-80ff09f38805"
      }
    }
  }
}
