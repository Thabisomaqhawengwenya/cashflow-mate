{
  "name": "cashflow-mate",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace=@cashflow-mate/api run dev",
    "dev:web": "npm --workspace=@cashflow-mate/web run dev",
    "mobile": "npm --prefix my-app run start",
    "mobile:web": "npm --prefix my-app run web",
    "mobile:android": "npm --prefix my-app run android",
    "mobile:ios": "npm --prefix my-app run ios",
    "build": "npm --workspace=@cashflow-mate/shared run build && npm --workspace=@cashflow-mate/api run build && npm --workspace=@cashflow-mate/web run build",
    "test": "npm --workspace=@cashflow-mate/shared run test && npm --workspace=@cashflow-mate/api run test && npm --prefix my-app test",
    "preview": "node tools/preview.mjs",
    "council": "node tools/council/hub.mjs",
    "council:broadcast": "node tools/council/hub.mjs --broadcast",
    "deepseek:watch": "node tools/deepseek-bridge/watch.mjs --once",
    "deepseek:notify": "node tools/deepseek-bridge/notify.mjs",
    "deepseek:server": "node tools/deepseek-bridge/server.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
